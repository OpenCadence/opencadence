# Optional. Relative paths resolve from the project root.
DATABASE_PATH=data/cadence.sqlite

# Optional: comma-separated hostnames accepted in addition to localhost.
# Only set this behind the authenticated reverse proxy described in docs/SELF_HOSTING.md.
# CADENCE_ALLOWED_HOSTS=cadence.example.com

# Optional: expose only read tools from the local MCP server (restart it to apply).
# CADENCE_MCP_READ_ONLY=1
