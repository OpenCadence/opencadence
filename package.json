{
  "name": "opencadence",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "demo": "node scripts/demo.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "test": "pnpm test:unit && pnpm test:mcp",
    "test:unit": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "backup": "node scripts/backup.mjs",
    "format": "prettier --write src tests scripts next.config.ts playwright.config.ts",
    "format:check": "prettier --check src tests scripts next.config.ts playwright.config.ts",
    "mcp": "node scripts/mcp.mjs",
    "mcp:config": "node scripts/mcp.mjs --print-config",
    "test:mcp": "node --import tsx --test tests/integration/mcp.test.ts",
    "test:ui": "pnpm build && playwright test"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@next/env": "^16.1.6",
    "lucide-react": "^0.577.0",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "server-only": "^0.0.1",
    "tsx": "^4.23.13",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.16.1",
  "license": "AGPL-3.0-only",
  "homepage": "https://opencadence.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenCadence/opencadence.git"
  },
  "bugs": {
    "url": "https://github.com/OpenCadence/opencadence/issues"
  }
}
